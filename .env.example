# Site Configuration
PUBLIC_SITE_URL=https://astralumen.science
PUBLIC_SITE_NAME=AstraLumen

# Google Analytics
PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Tag Manager
PUBLIC_GTM_ID=GTM-XXXXXXX

# Newsletter Provider: mailchimp | brevo | convertkit
NEWSLETTER_PROVIDER=mailchimp

# Mailchimp
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_LIST_ID=your_list_id
MAILCHIMP_SERVER_PREFIX=us1

# Brevo (Sendinblue)
BREVO_API_KEY=your_brevo_api_key
BREVO_LIST_ID=your_list_id

# ConvertKit
CONVERTKIT_API_KEY=your_convertkit_api_key
CONVERTKIT_FORM_ID=your_form_id

# Contact Form
CONTACT_EMAIL=contact@astralumen.science
CONTACT_FROM_EMAIL=noreply@astralumen.science

# Spam Protection (honeypot + rate limit)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
