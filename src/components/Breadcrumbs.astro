---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((item, i) => (
      <li>
        {item.href && i < items.length - 1 ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.8125rem;
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--text-muted);
    margin: 0;
  }

  .breadcrumbs li:not(:last-child)::after {
    content: '›';
    color: var(--mist);
    margin-left: var(--space-xs);
  }

  .breadcrumbs a {
    color: var(--text-secondary);
  }

  .breadcrumbs a:hover {
    color: var(--aurora);
  }

  .breadcrumbs [aria-current="page"] {
    color: var(--starlight);
  }
</style>
