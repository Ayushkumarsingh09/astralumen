---
import { SITE, FOOTER_LINKS } from '@/config/site';
import Newsletter from '@components/Newsletter.astro';
---

<footer class="footer" role="contentinfo">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <svg viewBox="0 0 48 48" width="48" height="48" aria-hidden="true">
            <defs>
              <linearGradient id="footerGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#7c3aed"/>
                <stop offset="100%" style="stop-color:#06b6d4"/>
              </linearGradient>
            </defs>
            <circle cx="24" cy="24" r="20" fill="none" stroke="url(#footerGrad)" stroke-width="2"/>
            <circle cx="24" cy="24" r="5" fill="url(#footerGrad)"/>
          </svg>
          <div>
            <span class="footer-name">{SITE.name}</span>
            <span class="footer-tagline">{SITE.tagline}</span>
          </div>
        </a>
        <p class="footer-desc">{SITE.description}</p>
      </div>

      <div class="footer-links-grid">
        <div>
          <h3 class="footer-heading">Explore</h3>
          <ul>
            {FOOTER_LINKS.explore.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="footer-heading">Resources</h3>
          <ul>
            {FOOTER_LINKS.resources.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="footer-heading">Legal & Trust</h3>
          <ul>
            {FOOTER_LINKS.legal.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <Newsletter variant="footer" />

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <p class="footer-note">
        Scientific imagery courtesy of NASA, ESA, NOAA, and USGS public archives.
        Content reviewed by qualified science editors.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--deep-space);
    border-top: 1px solid var(--border);
    padding: var(--space-4xl) 0 var(--space-xl);
    margin-top: var(--space-4xl);
  }

  .footer-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--stellar), var(--aurora), transparent);
    box-shadow: 0 0 60px rgba(124, 58, 237, 0.4);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-3xl);
    margin-bottom: var(--space-3xl);
  }

  @media (max-width: 768px) {
    .footer-top { grid-template-columns: 1fr; }
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    text-decoration: none;
  }

  .footer-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--starlight);
  }

  .footer-tagline {
    font-size: 0.75rem;
    color: var(--aurora);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .footer-desc {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 360px;
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  @media (max-width: 600px) {
    .footer-links-grid { grid-template-columns: 1fr; }
  }

  .footer-heading {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--aurora);
    margin-bottom: var(--space-lg);
  }

  .footer-links-grid ul {
    list-style: none;
    padding: 0;
  }

  .footer-links-grid li {
    margin-bottom: var(--space-sm);
  }

  .footer-links-grid a {
    font-size: 0.875rem;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .footer-links-grid a:hover {
    color: var(--starlight);
  }

  .footer-bottom {
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border-light);
    text-align: center;
  }

  .footer-bottom p {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .footer-note {
    font-size: 0.75rem !important;
    max-width: 600px;
    margin: 0 auto !important;
  }
</style>
