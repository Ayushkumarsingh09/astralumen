---
interface Props {
  refs: { title: string; url: string }[];
}
const { refs } = Astro.props;
---

<section class="references" aria-labelledby="refs-heading">
  <h2 id="refs-heading" class="refs-title">References & Further Reading</h2>
  <ol class="refs-list">
    {refs.map((ref) => (
      <li>
        <a href={ref.url} target="_blank" rel="noopener noreferrer">{ref.title}</a>
      </li>
    ))}
  </ol>
</section>

<style>
  .refs-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-bottom: var(--space-lg);
    color: var(--starlight);
  }

  .refs-list {
    padding-left: var(--space-xl);
  }

  .refs-list li {
    margin-bottom: var(--space-sm);
    font-size: 0.9375rem;
  }

  .refs-list a {
    color: var(--aurora-light);
  }

  .refs-list a:hover {
    text-decoration: underline;
  }
</style>
