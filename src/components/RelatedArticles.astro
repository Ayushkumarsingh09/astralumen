---
import { getCollection } from 'astro:content';

interface Props {
  slugs: string[];
}
const { slugs } = Astro.props;

const allArticles = await getCollection('articles');
const related = slugs
  .map((slug) => allArticles.find((a) => a.slug === slug))
  .filter(Boolean)
  .slice(0, 4);
---

{related.length > 0 && (
  <section class="related" aria-labelledby="related-heading">
    <h2 id="related-heading" class="related-title">Related Articles</h2>
    <div class="related-grid">
      {related.map((article) => (
        <a href={`/articles/${article!.slug}`} class="related-card glass-card">
          <img
            src={article!.data.featuredImage}
            alt={article!.data.title}
            width="400"
            height="225"
            loading="lazy"
          />
          <div class="related-content">
            <h3>{article!.data.title}</h3>
            <p>{article!.data.description.slice(0, 100)}…</p>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-bottom: var(--space-xl);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-lg);
  }

  .related-card {
    padding: 0;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .related-card img {
    width: 100%;
    height: 160px;
    object-fit: cover;
  }

  .related-content {
    padding: var(--space-lg);
  }

  .related-content h3 {
    font-size: 1rem;
    margin-bottom: var(--space-sm);
    color: var(--starlight);
  }

  .related-content p {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
  }
</style>
