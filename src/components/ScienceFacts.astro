---
interface Props {
  facts: string[];
}
const { facts } = Astro.props;
---

<section class="science-facts" aria-labelledby="facts-heading">
  <h2 id="facts-heading" class="facts-title">🔬 Key Science Facts</h2>
  <ul class="facts-list">
    {facts.map((fact) => (
      <li class="fact-item">{fact}</li>
    ))}
  </ul>
</section>

<style>
  .science-facts {
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.1), rgba(6, 182, 212, 0.1));
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .facts-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    margin-bottom: var(--space-lg);
    color: var(--stellar-light);
  }

  .facts-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-md);
  }

  .fact-item {
    position: relative;
    padding-left: var(--space-xl);
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
  }

  .fact-item::before {
    content: '✦';
    position: absolute;
    left: 0;
    color: var(--gold);
    font-size: 0.875rem;
  }
</style>
