---
import { getCollection } from 'astro:content';

const articles = await getCollection('articles', ({ data }) => !data.draft);
const featured = articles
  .sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime())
  .slice(0, 6);
---

<section class="section featured" aria-labelledby="featured-heading">
  <div class="container">
    <header class="section-header">
      <span class="section-label">Latest Discoveries</span>
      <h2 id="featured-heading" class="section-title">Featured Science Stories</h2>
      <p class="section-subtitle">In-depth articles reviewed by qualified scientists and educators.</p>
    </header>

    <div class="featured-grid">
      {featured.map((article, i) => (
        <a
          href={`/articles/${article.slug}`}
          class={`featured-card glass-card ${i === 0 ? 'featured-card--hero' : ''}`}
        >
          <div class="card-image">
            <img
              src={article.data.featuredImage}
              alt={article.data.title}
              width="600"
              height="340"
              loading={i < 2 ? 'eager' : 'lazy'}
              onerror="this.onerror=null;this.src='/images/og-default.svg'"
            />
          </div>
          <div class="card-content">
            <span class="card-category">{article.data.category.replace('-', ' ')}</span>
            <h3 class="card-title">{article.data.title}</h3>
            <p class="card-desc">{article.data.description}</p>
            <div class="card-meta">
              <span>{article.data.readingTime} min read</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="featured-cta">
      <a href="/science-news" class="btn btn-secondary">View All Articles</a>
    </div>
  </div>
</section>

<style>
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  @media (max-width: 1024px) {
    .featured-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .featured-grid { grid-template-columns: 1fr; }
  }

  .featured-card {
    padding: 0;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .featured-card--hero {
    grid-column: span 2;
    grid-row: span 2;
  }

  @media (max-width: 1024px) {
    .featured-card--hero {
      grid-column: span 1;
      grid-row: span 1;
    }
  }

  .card-image img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .featured-card--hero .card-image img {
    height: 320px;
  }

  .card-content {
    padding: var(--space-lg);
  }

  .card-category {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--aurora);
  }

  .card-title {
    font-size: 1.125rem;
    margin: var(--space-sm) 0;
    color: var(--starlight);
    line-height: 1.3;
  }

  .featured-card--hero .card-title {
    font-size: 1.5rem;
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .featured-cta {
    text-align: center;
    margin-top: var(--space-3xl);
  }
</style>
