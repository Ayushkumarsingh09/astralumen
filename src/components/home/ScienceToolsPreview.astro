---
const tools = [
  { name: 'Planet Weight Calculator', href: '/science-tools/planet-weight-calculator', icon: '⚖️' },
  { name: 'Age on Other Planets', href: '/science-tools/age-on-planets', icon: '🎂' },
  { name: 'Light Year Converter', href: '/science-tools/light-year-converter', icon: '💫' },
  { name: 'Gravity Calculator', href: '/science-tools/gravity-calculator', icon: '🍎' },
  { name: 'Periodic Table', href: '/science-tools/periodic-table', icon: '🧪' },
  { name: 'Solar System Explorer', href: '/science-tools/solar-system-explorer', icon: '🪐' },
];
---

<section class="section tools-preview" aria-labelledby="tools-heading">
  <div class="container">
    <header class="section-header">
      <span class="section-label">Interactive Learning</span>
      <h2 id="tools-heading" class="section-title">Science Tools</h2>
      <p class="section-subtitle">Hands-on calculators and explorers to deepen your understanding.</p>
    </header>

    <div class="tools-grid">
      {tools.map((tool) => (
        <a href={tool.href} class="tool-card glass-card">
          <span class="tool-icon">{tool.icon}</span>
          <span class="tool-name">{tool.name}</span>
        </a>
      ))}
    </div>

    <div class="tools-cta">
      <a href="/science-tools" class="btn btn-primary">View All Tools</a>
    </div>
  </div>
</section>

<style>
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-lg);
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-xl);
    text-decoration: none;
    color: inherit;
    gap: var(--space-md);
  }

  .tool-icon {
    font-size: 2.5rem;
  }

  .tool-name {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--starlight);
  }

  .tools-cta {
    text-align: center;
    margin-top: var(--space-2xl);
  }
</style>
