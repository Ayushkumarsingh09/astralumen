---
import PageLayout from '@layouts/PageLayout.astro';
---

<PageLayout
  title="Page Not Found — Lost in Space"
  description="The page you're looking for doesn't exist. Explore AstraLumen's science articles, tools, and educational resources instead."
  noindex={true}
>
  <section class="not-found">
    <div class="container not-found-inner">
      <div class="orbit-system" aria-hidden="true">
        <div class="star star--1"></div>
        <div class="star star--2"></div>
        <div class="star star--3"></div>
        <div class="planet planet--center">🪐</div>
        <div class="orbit orbit--1"><span class="planet planet--1">🌍</span></div>
        <div class="orbit orbit--2"><span class="planet planet--2">🌙</span></div>
        <div class="orbit orbit--3"><span class="planet planet--3">☄️</span></div>
      </div>

      <div class="not-found-content">
        <p class="error-code">404</p>
        <h1>Houston, We Have a Problem</h1>
        <p class="error-message">
          The page you're looking for has drifted beyond our observable universe.
          It may have been moved, renamed, or never existed in this dimension.
        </p>

        <div class="not-found-actions">
          <a href="/" class="btn btn-primary">Return to Home</a>
          <a href="/search" class="btn btn-secondary">Search Articles</a>
        </div>

        <div class="quick-links">
          <p>Or try one of these destinations:</p>
          <ul>
            <li><a href="/space">Space</a></li>
            <li><a href="/science-tools">Science Tools</a></li>
            <li><a href="/science-facts">Science Facts</a></li>
            <li><a href="/sitemap">Sitemap</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .not-found {
    min-height: calc(100vh - var(--header-height) - 200px);
    display: flex;
    align-items: center;
    padding: var(--space-4xl) 0;
  }

  .not-found-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
    align-items: center;
  }

  @media (max-width: 900px) {
    .not-found-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }

  .orbit-system {
    position: relative;
    width: 320px;
    height: 320px;
    margin: 0 auto;
  }

  .planet--center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 4rem;
    z-index: 2;
    filter: drop-shadow(0 0 20px rgba(124, 58, 237, 0.5));
  }

  .orbit {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px dashed rgba(124, 58, 237, 0.2);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .orbit--1 {
    width: 180px;
    height: 180px;
    animation: spin 12s linear infinite;
  }

  .orbit--2 {
    width: 240px;
    height: 240px;
    animation: spin 18s linear infinite reverse;
  }

  .orbit--3 {
    width: 300px;
    height: 300px;
    animation: spin 25s linear infinite;
  }

  .orbit .planet {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 1.5rem;
  }

  .star {
    position: absolute;
    width: 3px;
    height: 3px;
    background: white;
    border-radius: 50%;
    animation: twinkle 2s ease-in-out infinite;
  }

  .star--1 { top: 10%; left: 20%; animation-delay: 0s; }
  .star--2 { top: 30%; right: 15%; animation-delay: 0.5s; }
  .star--3 { bottom: 20%; left: 30%; animation-delay: 1s; }

  @keyframes spin {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.5); }
  }

  .error-code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 7rem);
    font-weight: 800;
    line-height: 1;
    margin-bottom: var(--space-md);
    background: linear-gradient(135deg, var(--stellar), var(--aurora));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .not-found-content h1 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: var(--space-lg);
    color: var(--starlight);
  }

  .error-message {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 480px;
    margin-bottom: var(--space-2xl);
  }

  @media (max-width: 900px) {
    .error-message { margin-left: auto; margin-right: auto; }
  }

  .not-found-actions {
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  @media (max-width: 900px) {
    .not-found-actions { justify-content: center; }
  }

  @media (max-width: 480px) {
    .not-found-actions { flex-direction: column; align-items: center; }
  }

  .quick-links p {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .quick-links ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  @media (max-width: 900px) {
    .quick-links ul { justify-content: center; }
  }

  .quick-links a {
    font-size: 0.875rem;
    color: var(--aurora);
    padding: 0.25rem 0.75rem;
    border: 1px solid rgba(6, 182, 212, 0.3);
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .quick-links a:hover {
    background: rgba(6, 182, 212, 0.1);
    color: var(--aurora-light);
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit--1, .orbit--2, .orbit--3, .star {
      animation: none;
    }
  }
</style>
