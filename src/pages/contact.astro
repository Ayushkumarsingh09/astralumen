---
import PageLayout from '@layouts/PageLayout.astro';
import { SITE } from '@/config/site';
---

<PageLayout
  title="Contact AstraLumen — Get in Touch"
  description="Contact the AstraLumen team for editorial inquiries, corrections, partnerships, or general questions about our science education content."
  breadcrumbs={[{ label: 'Contact' }]}
>
  <section class="page-hero">
    <div class="container">
      <span class="section-label">Reach Out</span>
      <h1>Contact Us</h1>
      <p class="hero-lead">
        Have a question, correction, or partnership inquiry? We'd love to hear from you.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info glass-card">
        <h2>Other Ways to Connect</h2>
        <div class="info-item">
          <span class="info-label">Email</span>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
        <div class="info-item">
          <span class="info-label">Corrections</span>
          <p>Report factual errors via our <a href="/corrections-policy">corrections policy</a>.</p>
        </div>
        <div class="info-item">
          <span class="info-label">Editorial</span>
          <p>Learn how we review content on our <a href="/editorial-policy">editorial policy</a> page.</p>
        </div>
        <div class="info-item">
          <span class="info-label">Response Time</span>
          <p>We aim to respond within 2–3 business days.</p>
        </div>
      </div>

      <form id="contact-form" class="contact-form glass-card" novalidate>
        <div id="form-status" class="form-status" role="alert" aria-live="polite" hidden></div>

        <!-- Honeypot — hidden from real users -->
        <div class="honeypot" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-group">
          <label for="name">Full Name <span class="required">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name" />
          <span class="field-error" id="name-error"></span>
        </div>

        <div class="form-group">
          <label for="email">Email Address <span class="required">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" />
          <span class="field-error" id="email-error"></span>
        </div>

        <div class="form-group">
          <label for="subject">Subject <span class="required">*</span></label>
          <select id="subject" name="subject" required>
            <option value="">Select a topic…</option>
            <option value="general">General Inquiry</option>
            <option value="correction">Report a Correction</option>
            <option value="editorial">Editorial / Content</option>
            <option value="partnership">Partnership</option>
            <option value="technical">Technical Issue</option>
            <option value="other">Other</option>
          </select>
          <span class="field-error" id="subject-error"></span>
        </div>

        <div class="form-group">
          <label for="message">Message <span class="required">*</span></label>
          <textarea id="message" name="message" rows="6" required minlength="20" placeholder="Please provide as much detail as possible…"></textarea>
          <span class="field-error" id="message-error"></span>
        </div>

        <button type="submit" class="btn btn-primary" id="submit-btn">
          <span class="btn-text">Send Message</span>
          <span class="btn-loading" hidden>Sending…</span>
        </button>
      </form>
    </div>
  </section>
</PageLayout>

<style>
  .page-hero {
    padding: var(--space-3xl) 0 var(--space-xl);
    text-align: center;
  }

  .hero-lead {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 560px;
    margin: var(--space-lg) auto 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-2xl);
    align-items: start;
    padding-bottom: var(--space-4xl);
  }

  .contact-info h2 {
    font-size: 1.25rem;
    margin-bottom: var(--space-xl);
    color: var(--stellar-light);
  }

  .info-item {
    margin-bottom: var(--space-lg);
  }

  .info-label {
    display: block;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--aurora);
    margin-bottom: var(--space-xs);
  }

  .info-item p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-group {
    margin-bottom: var(--space-lg);
  }

  .form-group label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--starlight);
    margin-bottom: var(--space-sm);
  }

  .required { color: var(--mars); }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(5, 5, 16, 0.6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--starlight);
    font-family: var(--font-body);
    font-size: 1rem;
    transition: border-color var(--transition-fast);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--aurora);
    outline: none;
  }

  .form-group input.invalid,
  .form-group select.invalid,
  .form-group textarea.invalid {
    border-color: var(--mars);
  }

  .field-error {
    display: block;
    font-size: 0.8125rem;
    color: var(--mars);
    margin-top: var(--space-xs);
    min-height: 1.25rem;
  }

  .form-status {
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-lg);
    font-size: 0.9375rem;
  }

  .form-status.success {
    background: rgba(6, 182, 212, 0.15);
    border: 1px solid rgba(6, 182, 212, 0.4);
    color: var(--aurora-light);
  }

  .form-status.error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #fca5a5;
  }

  .contact-form .btn-primary {
    width: 100%;
    margin-top: var(--space-sm);
  }

  .contact-form .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('form-status') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = submitBtn?.querySelector('.btn-text') as HTMLSpanElement;
  const btnLoading = submitBtn?.querySelector('.btn-loading') as HTMLSpanElement;

  const fields = {
    name: { el: document.getElementById('name') as HTMLInputElement, error: document.getElementById('name-error') as HTMLSpanElement },
    email: { el: document.getElementById('email') as HTMLInputElement, error: document.getElementById('email-error') as HTMLSpanElement },
    subject: { el: document.getElementById('subject') as HTMLSelectElement, error: document.getElementById('subject-error') as HTMLSpanElement },
    message: { el: document.getElementById('message') as HTMLTextAreaElement, error: document.getElementById('message-error') as HTMLSpanElement },
  };

  function validateEmail(email: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function clearErrors() {
    Object.values(fields).forEach(({ el, error }) => {
      el.classList.remove('invalid');
      error.textContent = '';
    });
    statusEl.hidden = true;
    statusEl.className = 'form-status';
  }

  function validate(): boolean {
    clearErrors();
    let valid = true;

    if (!fields.name.el.value.trim()) {
      fields.name.el.classList.add('invalid');
      fields.name.error.textContent = 'Please enter your name.';
      valid = false;
    }

    if (!fields.email.el.value.trim()) {
      fields.email.el.classList.add('invalid');
      fields.email.error.textContent = 'Please enter your email address.';
      valid = false;
    } else if (!validateEmail(fields.email.el.value)) {
      fields.email.el.classList.add('invalid');
      fields.email.error.textContent = 'Please enter a valid email address.';
      valid = false;
    }

    if (!fields.subject.el.value) {
      fields.subject.el.classList.add('invalid');
      fields.subject.error.textContent = 'Please select a subject.';
      valid = false;
    }

    const msg = fields.message.el.value.trim();
    if (!msg) {
      fields.message.el.classList.add('invalid');
      fields.message.error.textContent = 'Please enter your message.';
      valid = false;
    } else if (msg.length < 20) {
      fields.message.el.classList.add('invalid');
      fields.message.error.textContent = 'Message must be at least 20 characters.';
      valid = false;
    }

    return valid;
  }

  function showStatus(message: string, type: 'success' | 'error') {
    statusEl.textContent = message;
    statusEl.className = `form-status ${type}`;
    statusEl.hidden = false;
    statusEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    btnText.hidden = loading;
    btnLoading.hidden = !loading;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate()) return;

    const honeypot = (document.getElementById('website') as HTMLInputElement).value;
    if (honeypot) return;

    setLoading(true);

    try {
      const response = await fetch('/api/contact.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: fields.name.el.value.trim(),
          email: fields.email.el.value.trim(),
          subject: fields.subject.el.value,
          message: fields.message.el.value.trim(),
        }),
      });

      const data = await response.json().catch(() => ({}));

      if (response.ok) {
        showStatus('Thank you! Your message has been sent successfully. We\'ll get back to you soon.', 'success');
        form.reset();
      } else {
        showStatus(data.error || 'Something went wrong. Please try again or email us directly.', 'error');
      }
    } catch {
      showStatus('Unable to send your message. Please check your connection or email us directly.', 'error');
    } finally {
      setLoading(false);
    }
  });
</script>
