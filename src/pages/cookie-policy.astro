---
import PageLayout from '@layouts/PageLayout.astro';
import { SITE } from '@/config/site';

const lastUpdated = 'June 16, 2025';
---

<PageLayout
  title="Cookie Policy — AstraLumen"
  description="Learn how AstraLumen uses cookies and similar technologies on our science education website, and how to manage your preferences."
  breadcrumbs={[{ label: 'Cookie Policy' }]}
>
  <section class="page-hero">
    <div class="container">
      <span class="section-label">Legal</span>
      <h1>Cookie Policy</h1>
      <p class="hero-meta">Last updated: {lastUpdated}</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <p>
        This Cookie Policy explains how {SITE.name} ("we," "us," or "our") uses cookies and
        similar tracking technologies when you visit {SITE.url}. It should be read alongside
        our <a href="/privacy-policy">Privacy Policy</a>.
      </p>

      <h2>What Are Cookies?</h2>
      <p>
        Cookies are small text files placed on your device when you visit a website. They help
        the site remember your preferences, understand how you use the site, and deliver
        relevant content and advertisements.
      </p>

      <h2>Types of Cookies We Use</h2>

      <h3>Essential Cookies</h3>
      <p>
        These cookies are necessary for the Site to function properly. They enable basic
        features such as page navigation and access to secure areas. The Site cannot function
        properly without these cookies.
      </p>

      <h3>Analytics Cookies</h3>
      <p>
        We use analytics services (such as Google Analytics) to understand how visitors interact
        with our Site. These cookies collect information anonymously, including the number of
        visitors, pages viewed, and traffic sources. This helps us improve our science content
        and user experience.
      </p>

      <h3>Advertising Cookies</h3>
      <p>
        We may use advertising cookies (such as Google AdSense) to display relevant ads and
        measure ad performance. These cookies track your browsing activity across websites to
        build a profile of your interests. Third-party advertisers may set their own cookies
        when serving ads on our Site.
      </p>

      <h3>Functional Cookies</h3>
      <p>
        These cookies remember choices you make (such as language preferences or search history
        on our Site) to provide enhanced, personalized features.
      </p>

      <h2>Cookies We May Use</h2>
      <table>
        <thead>
          <tr>
            <th>Cookie</th>
            <th>Provider</th>
            <th>Purpose</th>
            <th>Duration</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>_ga, _ga_*</td>
            <td>Google Analytics</td>
            <td>Distinguish users and sessions</td>
            <td>Up to 2 years</td>
          </tr>
          <tr>
            <td>_gid</td>
            <td>Google Analytics</td>
            <td>Distinguish users</td>
            <td>24 hours</td>
          </tr>
          <tr>
            <td>_gat</td>
            <td>Google Analytics</td>
            <td>Throttle request rate</td>
            <td>1 minute</td>
          </tr>
          <tr>
            <td>IDE, DSID</td>
            <td>Google AdSense</td>
            <td>Ad targeting and measurement</td>
            <td>Up to 2 years</td>
          </tr>
        </tbody>
      </table>

      <h2>Third-Party Cookies</h2>
      <p>
        Some cookies are set by third-party services that appear on our pages. We do not control
        these cookies. Please refer to the respective third-party privacy policies:
      </p>
      <ul>
        <li><a href="https://policies.google.com/technologies/cookies" rel="noopener noreferrer" target="_blank">Google Cookie Policy</a></li>
        <li><a href="https://policies.google.com/privacy" rel="noopener noreferrer" target="_blank">Google Privacy Policy</a></li>
      </ul>

      <h2>Managing Cookies</h2>
      <p>You can control and manage cookies in several ways:</p>
      <ul>
        <li><strong>Browser settings</strong> — Most browsers allow you to refuse or delete cookies. See your browser's help documentation for instructions.</li>
        <li><strong>Google Analytics opt-out</strong> — Install the <a href="https://tools.google.com/dlpage/gaoptout" rel="noopener noreferrer" target="_blank">Google Analytics Opt-out Browser Add-on</a>.</li>
        <li><strong>Ad personalization</strong> — Visit <a href="https://www.google.com/settings/ads" rel="noopener noreferrer" target="_blank">Google Ads Settings</a> or <a href="https://optout.aboutads.info/" rel="noopener noreferrer" target="_blank">aboutads.info</a> to opt out of personalized advertising.</li>
      </ul>
      <p>
        Please note that disabling certain cookies may affect the functionality of the Site and
        your user experience.
      </p>

      <h2>Do Not Track</h2>
      <p>
        Some browsers offer a "Do Not Track" (DNT) signal. There is no universal standard for
        responding to DNT signals. Currently, we do not alter our data collection practices in
        response to DNT signals.
      </p>

      <h2>Updates to This Policy</h2>
      <p>
        We may update this Cookie Policy periodically. Changes will be posted on this page with
        an updated date. We encourage you to review this policy regularly.
      </p>

      <h2>Contact Us</h2>
      <p>
        If you have questions about our use of cookies, contact us at
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </section>
</PageLayout>

<style>
  .page-hero {
    padding: var(--space-3xl) 0 var(--space-xl);
    text-align: center;
  }

  .hero-meta {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-top: var(--space-md);
  }

  .section {
    padding-bottom: var(--space-4xl);
  }
</style>
